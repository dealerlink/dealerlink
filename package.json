{
  "name": "dealerlink",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:workers": "pnpm --filter workers dev",
    "dev:all": "pnpm --parallel --filter \"web\" --filter \"workers\" dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "lint": "pnpm -r lint",
    "lint:strict": "pnpm -r lint",
    "lint:fix": "pnpm -r exec eslint --fix --no-error-on-unmatched-pattern .",
    "preflight": "node scripts/preflight.mjs",
    "plan:sync": "tsx scripts/sync-project-plan.ts",
    "plan:check": "tsx scripts/sync-project-plan.ts --check",
    "sync-spec:staging": "node scripts/sync-app-spec.mjs staging",
    "sync-spec:production": "node scripts/sync-app-spec.mjs production",
    "verify": "pnpm plan:check && pnpm --filter web exec playwright test --project=chromium",
    "verify:latest": "pnpm --filter web exec playwright test --project=chromium --grep verify-day-8",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "test": "pnpm -r test && pnpm test:scripts",
    "test:e2e": "pnpm --filter web test:e2e",
    "db:generate": "pnpm --filter @dealerlink/db db:generate",
    "db:migrate": "pnpm --filter @dealerlink/db db:migrate",
    "db:rollback": "pnpm --filter @dealerlink/db db:rollback",
    "db:seed": "pnpm --filter @dealerlink/db db:seed",
    "db:studio": "pnpm --filter @dealerlink/db db:studio",
    "prepare": "husky",
    "playwright:install": "pnpm --filter web exec playwright install chromium",
    "test:scripts": "vitest run --config scripts/vitest.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9",
    "yaml": "^2.8.0"
  },
  "pnpm": {
    "overrides": {
      "zod": "3.25.76"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-error-on-unmatched-pattern"
    ],
    "*.{json,css,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
