# ============================================================================
# Dealerlink — packages/db test environment (COMMITTED)
# ============================================================================
# Loaded by tests/setup-env.ts (see packages/db/vitest.config.ts) so that
# `pnpm test` / `pnpm --filter @dealerlink/db test` works from a genuinely
# clean shell in the devcontainer, without any exported env. Fixes DEV.88.
#
# SAFE TO COMMIT: these are the docker-compose DEV/TEST database credentials
# only — the identical values already live in the committed `.env.example`.
# They are NOT secrets: no API keys, no session secret, no production creds.
# The `dealerlink_dev` database is a throwaway local Postgres.
#
# Host is `postgres` — the docker-compose service name, reachable on the
# Compose network from inside the dev container (NOT `localhost`, which is the
# fallback the db test files used before this file existed — that fallback is
# what broke `pnpm test` post-devcontainer-migration; see DEV.88).
#
# A developer's own repo-root `.env.local` (gitignored) is loaded FIRST by
# tests/setup-env.ts and takes precedence, so overriding the host/creds for a
# non-compose Postgres needs no change here.
# ----------------------------------------------------------------------------

# App runtime role — NOLOGIN-equivalent, NOBYPASSRLS. What the RLS/integration
# tests connect as (they read APP_DATABASE_URL).
APP_DATABASE_URL=postgresql://dealerlink_app:dev_app_password_change_me@postgres:5432/dealerlink_dev

# Same app-role URL under the name the @dealerlink/db client reads.
DATABASE_URL=postgresql://dealerlink_app:dev_app_password_change_me@postgres:5432/dealerlink_dev

# Superuser role — used by the tenant-provisioning test (adminDb / migrations).
DATABASE_DIRECT_URL=postgresql://dealerlink:dev_password_change_me@postgres:5432/dealerlink_dev
